{
  "name": "localmark",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "cli": "node --import tsx src/cli.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "app": "swift run --package-path menubar",
    "app:build": "bash packaging/build-menubar-app.sh",
    "app:open": "open \"dist/Localmark.app\""
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
